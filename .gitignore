# Upstream reveal.js ignores a bare `presentation` here -- it is one of its own
# build artifacts. This deck *lives* in presentation/, so that line is replaced
# by the specific artifact it was meant to catch.
presentation.zip

dist/reveal.es5.js
react/dist
react/demo/dist
dev.html

# ---------------------------------------------------------------------------
# Deck media
# ---------------------------------------------------------------------------
# Carried over verbatim from the WebSlides branch, and for the same reasons:
# the seminar's images and videos come to ~826 MB, which does not belong in a
# git repository -- clones would carry it forever and GitHub warns above 50 MB
# per file (two of the videos are 66 MB and 49 MB). The deck sources ARE
# tracked; the media lives alongside them on disk. Use Git LFS if these ever
# need to travel with the repo.
#
# Favicons are the exception: small, and the deck looks broken without them,
# so they stay tracked.
static/images/*
!static/images/favicons/
static/videos/*
!static/videos/.gitkeep
